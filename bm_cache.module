/** @noinspection PhpUnusedParameterInspection */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Attach the module library to pages where appropriate.
 *
 * Use the standard hook_page_attachments signature. Keep the parameter name
 * generic ($attachments) to match common examples and avoid confusion.
 */
function bm_cache_page_attachments(array &$attachments): void {
  // Ensure library exists in bm_cache.libraries.yml.
  $attachments['#attached']['library'][] = 'bm_cache/bm_cache';
}

/**
 * Provide help for the module. Drupal calls the route 'help.page.<module>'.
 *
 * Returning TranslatableMarkup or a plain string is compatible with Drupal 11.
 * Keep help content concise here — full multi-topic documentation lives in
 * help_topics/*.md files (Drupal will render those under the module help page).
 */
function bm_cache_help($route_name, RouteMatchInterface $route_match): string {
  if ($route_name === 'help.page.bm_cache') {
    $output = '<h2>' . t('Mondial-IT Cache Module') . '</h2>';
    $output .= '<p>' . t('Offers management of temporary and permanent caches, including selective flushing tools for Blue Marloc environments.') . '</p>';

    $output .= '<h3>' . t('Menus') . '</h3><ul>';
    $output .= '<li>' . t('<strong>BlueMarloc Cache</strong> — listed under Blue Marloc » Administration and opens the cache settings form.') . '</li>';
    $output .= '<li>' . t('<strong>Selective flush</strong> — child link that jumps directly to the selective cache flush form.') . '</li>';
    $output .= '</ul>';

    $output .= '<h3>' . t('URIs') . '</h3><ul>';
    $output .= '<li>' . t('<code>@path</code> (<code>@route</code>) — review module configuration.', [
      '@path' => '/admin/bm_cache/settings_form',
      '@route' => 'bm_cache.settings_form',
    ]) . '</li>';
    $output .= '<li>' . t('<code>@path</code> (<code>@route</code>) — selectively clear caches that the module exposes.', [
      '@path' => '/admin/flush/bluemarloc_cache_form',
      '@route' => 'bm_cache.cache_form',
    ]) . '</li>';
    $output .= '</ul>';

    return $output;
  }
  return '';
}
